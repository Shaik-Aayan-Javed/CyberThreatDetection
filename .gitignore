# Local configuration. .env.example is committed; .env is not.
# This project has no secrets, but .env stays local so a deployment's bind
# address and paths don't get pushed over someone else's.
.env
.env.local

.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Runtime output, not source. Regenerated by server.py on every replay.
data/alerts.jsonl

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Captures and the trained model ARE tracked, deliberately: a reviewer can then
# clone and run the demo without needing scapy or a training pass. Both are
# regenerated deterministically if you delete them:
#   python data/generate.py --seed 42
#   python train.py

# Local agent tooling config, not part of the deliverable
.claude/
