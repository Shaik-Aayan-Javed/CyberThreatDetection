# ---------------------------------------------------------------------------
# SIH26145 -- deployment configuration
#
# THERE ARE NO SECRETS IN THIS PROJECT. It reads packet captures off disk and
# talks to nobody: no API key, no token, no database credential, no account to
# authenticate against. That is not an oversight, it is the point -- the whole
# system is built to have no path back to the monitored network.
#
# So this file is deployment settings, not a secrets file. Copy it to .env and
# edit if you want to change the defaults:
#
#     cp .env.example .env          (PowerShell: copy .env.example .env)
#
# Everything below is optional. With no .env at all, the defaults shown here
# are exactly what the code uses.
#
# Read by server.py only. The detection path (engine.py, ingest/, features/,
# detectors/, alerts/) takes its settings from CLI flags instead, because it
# claims to open exactly one file -- the capture -- and tools/isolation_check.py
# verifies that. Configure the analyser with flags, the service with this file.
# ---------------------------------------------------------------------------

# --- service ---------------------------------------------------------------

# Bind address for the dashboard. Loopback by default.
# In a real enclave this becomes the enclave-internal interface. Do NOT bind
# 0.0.0.0 unless you know exactly who can reach the port -- the dashboard has
# no authentication, because in the intended deployment the network provides it.
SIH_HOST=127.0.0.1

# Dashboard port. Override with --port on the command line if it clashes.
SIH_PORT=8000

# --- paths -----------------------------------------------------------------
# Relative to the repo root. Change these only if you keep captures or the
# trained model somewhere else.

SIH_PCAP_DIR=data/pcaps
SIH_DASHBOARD=dashboard/index.html
SIH_ALERT_LOG=data/alerts.jsonl
SIH_MODEL_PATH=models/anomaly.joblib

# --- tuning ----------------------------------------------------------------

# How many alerts the server keeps in memory for the dashboard. Alerts beyond
# this are still written to SIH_ALERT_LOG; only the in-browser view is capped.
SIH_MAX_ALERTS=500

# Detection window in seconds. This is the big one: it sets the upper bound on
# alert latency, and every baseline and rate is computed per window. Changing
# it invalidates the trained model, which was fitted on 5-second windows --
# re-run `python train.py` after changing it.
SIH_WINDOW_S=5.0

# Default replay pacing for the dashboard's Start button.
#   0  = as fast as possible (benchmark)
#   1  = wall-clock faithful, honours packet timestamps (realistic demo)
#   20 = 20x, the default -- a 5-minute capture finishes in about 15 seconds
SIH_REPLAY_SPEED=20
